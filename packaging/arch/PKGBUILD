# Maintainer: jinzhongjia
pkgname=btpop
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4 Bluetooth popup and pairing agent for BlueZ (replaces blueman)"
arch=('x86_64' 'aarch64')
url="https://github.com/jinzhongjia/btpop"
license=('GPL-3.0-or-later')
depends=('gtk4' 'glib2' 'gtk4-layer-shell' 'bluez')
makedepends=('meson' 'ninja')
checkdepends=('desktop-file-utils')
optdepends=('ttf-jetbrains-mono-nerd: icons')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('96ddca06b3e2223d4ecb304784e64230a57511329732d87c3855f5b703b9908a')

build() {
  arch-meson "$pkgname-$pkgver" build -Dlayer_shell=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
